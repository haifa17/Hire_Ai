generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                       String              @id @default(uuid()) @db.Uuid
  email                    String              @unique
  password                 String
  googleId                 String?             @unique
  role                     Role                @default(CANDIDATE)
  isEmailVerified          Boolean             @default(false)
  emailVerificationToken   String?
  emailVerificationExpires DateTime?
  refreshToken             String?
  passwordResetToken       String?
  passwordResetExpires     DateTime?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  firstName                String
  lastName                 String
  address                  String?
  phone                    String?
  photoUrl                 String?
  isActive                 Boolean             @default(true)
  candidateProfile         CandidateProfile?
  candidate_resumes        candidate_resumes[]
  recruiterProfile         RecruiterProfile?
  resumes                  Resume[]
  jobOffers                JobOffer[]          @relation("RecruiterJobOffers")
  applications             Application[]
  recruiterInterviews      Interview[]         @relation("RecruiterInterviews")
  candidateInterviews      Interview[]         @relation("CandidateInterviews")
  jobReports               JobReport[]


  @@index([email])
  @@map("users")
}

model CandidateProfile {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @unique @db.Uuid
  professionalSummary String?
  openToWork          Boolean  @default(false)
  desiredSalary       Decimal? @db.Decimal(12, 2)
  desiredPosition     String?
  socialLinks         Json?
  experiences         Json?
  education           Json?
  languages           Json?
  skills              Json?
  projects            Json?
  certifications      Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("candidate_profiles")
}

model RecruiterProfile {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @unique @db.Uuid
  position   String?
  department String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  companyId  String   @db.Uuid
  company    Company  @relation(fields: [companyId], references: [id])
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("recruiter_profiles")
}

model Company {
  id          String             @id @default(uuid()) @db.Uuid
  name        String             @unique
  logoUrl     String?
  address     String?
  phone       String?
  industry    String?
  companySize String?
  description String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  recruiters  RecruiterProfile[]
  jobOffers   JobOffer[]

  @@index([name])
  @@map("companies")
}

model JobOffer {
  id                String             @id @default(uuid()) @db.Uuid
  companyId         String             @db.Uuid
  recruiterId       String             @db.Uuid
  title             String
  slug              String             @unique
  department        String?
  employmentType    JobEmploymentType
  workplaceType     JobWorkplaceType
  location          String
  country           String
  city              String
  salaryMin         Decimal?           @db.Decimal(12, 2)
  salaryMax         Decimal?           @db.Decimal(12, 2)
  currency          String             @default("USD")
  experienceLevel   JobExperienceLevel
  educationLevel    JobEducationLevel?
  description       String
  responsibilities  String[]
  requirements      String[]
  preferredSkills   String[]
  requiredSkills    String[]
  benefits          String[]
  languages         String[]
  openings          Int                @default(1)
  deadline          DateTime?
  startDate         DateTime?
  status            JobOfferStatus     @default(DRAFT)
  featured          Boolean            @default(false)
  urgent            Boolean            @default(false)
  views             Int                @default(0)
  applicationsCount Int                @default(0)
  deletedAt         DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  company           Company            @relation(fields: [companyId], references: [id])
  recruiter         User               @relation("RecruiterJobOffers", fields: [recruiterId], references: [id])
  applications      Application[]
  interviews        Interview[]
  reports           JobReport[]


  @@index([companyId])
  @@index([recruiterId])
  @@index([status])
  @@index([employmentType])
  @@index([workplaceType])
  @@index([createdAt])
  @@index([views])
  @@index([salaryMin, salaryMax])
  @@index([deletedAt])
  @@map("job_offers")
}

model Resume {
  id             String         @id @default(uuid()) @db.Uuid
  candidateId    String         @db.Uuid
  title          String
  language       ResumeLanguage
  jobDescription String
  content        Json
  atsScore       Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  candidate      User           @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@index([candidateId, createdAt])
  @@map("resumes")
}

model candidate_resumes {
  id        String       @id @db.Uuid
  userId    String       @db.Uuid
  title     String
  status    ResumeStatus @default(DRAFT)
  source    ResumeSource @default(AI)
  content   String
  atsScore  Int?
  atsTips   Json?
  metadata  Json?
  createdAt DateTime     @default(now())
  updatedAt DateTime
  users     User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, updatedAt])
}

enum Role {
  CANDIDATE
  RECRUITER
  ADMIN
}

enum LanguageLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  NATIVE
}

enum ResumeLanguage {
  EN
  FR
  AR
}

enum ResumeSource {
  AI
  MANUAL
}

enum ResumeStatus {
  DRAFT
  READY
  ARCHIVED
}

enum JobOfferStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum JobEmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  CDD
  CDI
  TEMPORARY
  INTERNSHIP
  FREELANCE
}

enum JobWorkplaceType {
  ONSITE
  HYBRID
  REMOTE
}

enum JobExperienceLevel {
  ENTRY
  JUNIOR
  MID
  SENIOR
  LEAD
  EXECUTIVE
}

enum JobEducationLevel {
  HIGH_SCHOOL
  ASSOCIATE
  BACHELOR
  MASTER
  PHD
  OTHER
}

enum ApplicationStatus {
  PENDING
  REVIEWED
  SHORTLISTED
  INTERVIEW
  ACCEPTED
  REJECTED
}

model Application {
  id          String            @id @default(uuid()) @db.Uuid
  candidateId String            @db.Uuid
  jobOfferId  String            @db.Uuid
  coverLetter String?
  coverLetterUrl String?
  coverLetterMetadata Json?
  cvUrl       String
  cvMetadata  Json?
  supportingDocuments Json?
  status      ApplicationStatus @default(PENDING)
  aiAnalysis  Json?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  candidate User     @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobOffer  JobOffer @relation(fields: [jobOfferId], references: [id], onDelete: Cascade)

  @@unique([candidateId, jobOfferId])
  @@index([candidateId])
  @@index([jobOfferId])
  @@index([status])
  @@map("applications")
}

model Interview {
  id             String          @id @default(uuid()) @db.Uuid
  title          String
  interviewType  InterviewType
  status         InterviewStatus @default(SCHEDULED)
  scheduledAt    DateTime
  duration       Int
  message        String?
  sendInvitation Boolean         @default(true)
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  recruiterId    String          @db.Uuid
  candidateId    String          @db.Uuid
  jobOfferId     String          @db.Uuid

  recruiter User     @relation("RecruiterInterviews", fields: [recruiterId], references: [id], onDelete: Cascade)
  candidate User     @relation("CandidateInterviews", fields: [candidateId], references: [id], onDelete: Cascade)
  jobOffer   JobOffer @relation(fields: [jobOfferId], references: [id], onDelete: Cascade)

  @@index([recruiterId, scheduledAt])
  @@index([candidateId, scheduledAt])
  @@index([jobOfferId])
  @@index([status])
  @@map("interviews")
}

enum InterviewType {
  VIDEO
  ONSITE
  PHONE
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

// ── Recommendation System ─────────────────────────────────────────────────

model Recommendation {
  id              String   @id @default(uuid()) @db.Uuid
  sourceId        String   @map("source_id") @db.Uuid
  sourceType      String   @map("source_type") // "candidate" | "job"
  targetId        String   @map("target_id") @db.Uuid
  targetType      String   @map("target_type") // "job" | "candidate"
  rank            Int
  overallScore    Float    @map("overall_score")
  scoreBreakdown  Json     @map("score_breakdown")
  explanation     String
  metadataPayload Json?    @map("metadata_payload")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  expiresAt       DateTime @map("expires_at")

  @@index([sourceId, sourceType, isActive])
  @@index([targetId, targetType])
  @@index([sourceId, sourceType, rank])
  @@map("recommendations")
}

model RecommendationLog {
  id            String   @id @default(uuid()) @db.Uuid
  sourceId      String   @map("source_id") @db.Uuid
  sourceType    String   @map("source_type")
  trigger       String   // "auto_publish", "manual_refresh", "profile_update", "scheduled"
  itemsSearched Int      @default(0) @map("items_searched")
  durationMs    Int      @default(0) @map("duration_ms")
  status        String   @default("pending") // "completed", "failed", "partial"
  errorMessage  String?  @map("error_message")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([sourceId, sourceType])
  @@index([createdAt])
  @@map("recommendation_logs")
}

// ── Job Reports ─────────────────────────────────────────────────────────────

enum ReportType {
  FRAUD
  INCORRECT_INFO
  SPAM
  EXPIRED
  INAPPROPRIATE_CONTENT
  OTHER
}

enum ReportStatus {
  PENDING
  RESOLVED
}

model JobReport {
  id         String       @id @default(uuid()) @db.Uuid
  jobOfferId String       @db.Uuid
  userId     String       @db.Uuid
  reason     String
  type       ReportType
  status     ReportStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  jobOffer JobOffer @relation(fields: [jobOfferId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([jobOfferId, userId])
  @@index([jobOfferId])
  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@map("job_reports")
}
