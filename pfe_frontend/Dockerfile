# syntax=docker/dockerfile:1
# ============================================================
# TalentBridge AI — Next.js 16 frontend
# ============================================================
# Multi-stage: deps -> builder -> runner, using Next's `standalone` output so
# the final image ships a self-contained server plus only the node_modules
# actually reached by the code (a few dozen MB instead of the full tree).
# ============================================================

# Node 24 (LTS), not 22: package-lock.json was generated by npm 11, which
# resolves some transitive versions (ajv, picomatch, @swc/helpers)
# differently from the npm 10 that ships with node:22. `npm ci` requires an
# exact match and fails on 22 with "lock file ... does not satisfy".
ARG NODE_VERSION=24-alpine


# ── Stage 1: dependencies ────────────────────────────────────
FROM node:${NODE_VERSION} AS deps

# Next.js (and the sharp image pipeline it bundles) links against glibc
# symbols that Alpine's musl needs a shim for.
RUN apk add --no-cache libc6-compat

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts


# ── Stage 2: build ───────────────────────────────────────────
FROM node:${NODE_VERSION} AS builder

RUN apk add --no-cache libc6-compat

WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY . .

# NEXT_PUBLIC_* values are inlined into the client bundle at BUILD time, so
# they have to be build args — a runtime `environment:` entry would arrive
# too late and the browser would fall back to the compiled-in default.
#
# These are public by definition (they end up in JavaScript served to every
# visitor), so passing them as build args leaks nothing. Real secrets
# (GROQ_API_KEY, OPENROUTER_API_KEY) are NOT build args: they stay runtime
# env vars, read only by the server-side /api/ai/enhance route.
ARG NEXT_PUBLIC_API_URL=http://localhost:3000
ARG NEXT_PUBLIC_SITE_URL=http://localhost:3001
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_PUBLIC_SITE_URL=${NEXT_PUBLIC_SITE_URL}

ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production

RUN npm run build


# ── Stage 3: development (hot reload) ────────────────────────
# Used by docker-compose.dev.yml, which bind-mounts the source over /app.
FROM node:${NODE_VERSION} AS development

RUN apk add --no-cache libc6-compat

WORKDIR /app

ENV NODE_ENV=development
ENV NEXT_TELEMETRY_DISABLED=1
# Required for file-watching to work across a bind mount on Windows/macOS,
# where inotify events from the host are not delivered to the container.
ENV WATCHPACK_POLLING=true

COPY --from=deps /app/node_modules ./node_modules
COPY . .

EXPOSE 3001

CMD ["npm", "run", "dev"]


# ── Stage 4: production runtime ──────────────────────────────
FROM node:${NODE_VERSION} AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3001
ENV HOSTNAME=0.0.0.0

RUN apk add --no-cache dumb-init

# `nextjs` (uid 1001) rather than reusing the image's `node` user, matching
# the ownership the standalone server expects for its cache directory.
RUN addgroup --system --gid 1001 nodejs \
    && adduser --system --uid 1001 nextjs

# public/ is served as static assets by the standalone server.
COPY --from=builder --chown=nextjs:nodejs /app/public ./public

# The standalone bundle: server.js + the traced subset of node_modules.
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
# Static chunks are emitted outside the standalone folder and must be placed
# back at the path the HTML references.
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

# src/i18n/request.ts reads messages/<locale>/*.json with fs.readdirSync at
# REQUEST time. Next's dependency tracer only follows static imports, so it
# does not copy this directory into .next/standalone — without this line every
# page would crash with ENOENT on the first render.
COPY --from=builder --chown=nextjs:nodejs /app/messages ./messages

USER nextjs

EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3001)+'/').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "server.js"]
