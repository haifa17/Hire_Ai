# Keeps secrets and local build artefacts out of the build context.
# Anything listed here can never end up in an image layer.

# Dependencies — reinstalled inside the image from the lockfile
node_modules
npm-debug.log*
yarn-error.log*

# Secrets — GROQ_API_KEY / OPENROUTER_API_KEY are injected at runtime
.env
.env.*
!.env.example

# Build output — regenerated by the builder stage
.next
out
build
dist
*.tsbuildinfo

# VCS and CI
.git
.gitignore
.github

# Editor / OS noise
.vscode
.idea
.DS_Store
Thumbs.db
*.log
tmp
temp
coverage

# Docker files themselves
Dockerfile
.dockerignore
